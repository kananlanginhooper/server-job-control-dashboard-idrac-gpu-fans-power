# Copy to .env next to compose.yaml and fill in. Never commit .env.
COMPOSE_PROFILES=hub
SJC_UI_PORT=8100
# optional: forward the UI's other /api/* calls to an existing dashboard API
SJC_LEGACY_API=
# data + controls only for these address prefixes, minus the excluded addresses (put the LAN router there)
SJC_CONTROL_NETS=127.,10.
SJC_CONTROL_EXCLUDE=
# trusted reverse proxies for X-Forwarded-* (the UI's nginx container is one)
FORWARDED_ALLOW_IPS=*

# --- UI / group standard ---
# wrapper origins allowed to frame the UI, space-separated (list the Home dashboards origins in the real .env)
FRAME_ANCESTORS="http://<wrapper-host>:<wrapper-port>"
UI_BASE_PATH=/
PUBLIC_URL=
LOGIN=off
OIDC_ISSUER=
OIDC_CLIENT_ID=
# machine names and descriptions for the UI: deploy/local/site.json (private, gitignored); see deploy/site.example.json
# agents publishing to this broker: services repo (server-job-control-services-idrac-gpu-fans-power), services/sjc-agent
