# Copy to .env next to compose.yaml and fill in. Never commit .env.
COMPOSE_PROFILES=hub
SJC_UI_PORT=8100
# publish ports on this IPv4 address only (the server's LAN address); never bare, which also binds IPv6 [::]
BIND_ADDR=127.0.0.1
# optional: forward the UI's other /api/* calls to an existing dashboard API
SJC_LEGACY_API=
# data + controls only for these address prefixes, minus the excluded addresses (put the LAN router there)
SJC_CONTROL_NETS=127.,10.
SJC_CONTROL_EXCLUDE=
# MQTT broker the back end reads live state from (compose sets mosquitto; the hub override sets 127.0.0.1)
SJC_MQTT_HOST=localhost
# MQTT broker port
SJC_MQTT_PORT=1883
# MQTT topic prefix (contracts/mqtt-topics.md)
SJC_MQTT_PREFIX=sjc
# machine names + descriptions for the UI (compose mounts deploy/local/site.json at /site/site.json)
SJC_SITE_FILE=
# trusted reverse proxies for X-Forwarded-* (the UI's nginx container is one)
FORWARDED_ALLOW_IPS=*

# --- UI / group standard ---
# wrapper origins allowed to frame the UI, space-separated (list the Home dashboards origins in the real .env)
FRAME_ANCESTORS="http://<wrapper-host>:<wrapper-port>"
UI_BASE_PATH=/
PUBLIC_URL=
LOGIN=off
OIDC_ISSUER=
OIDC_CLIENT_ID=
# machine names and descriptions for the UI: deploy/local/site.json (private, gitignored); see deploy/site.example.json
# agents publishing to this broker: services repo (server-job-control-services-idrac-gpu-fans-power), services/sjc-agent

# --- agent-API orders store (Postgres; not read by the code yet) ---
# database host
ORDERS_DB_HOST=<db-host>
# database port
ORDERS_DB_PORT=5432
# database name
ORDERS_DB_NAME=<db-name>
# database role
ORDERS_DB_USER=<db-user>
# database password (only in the real .env)
ORDERS_DB_PASSWORD=<password>
