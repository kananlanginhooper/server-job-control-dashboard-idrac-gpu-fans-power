# Copy to .env next to compose.yaml on each server and fill in. Never commit .env.

# --- main server: broker + backend + UI + its own agent ---
COMPOSE_PROFILES=hub,agent
SJC_HOST=server-a
SJC_UI_PORT=8099
# optional: forward the UI's other /api/* calls to an existing dashboard API
# SJC_LEGACY_API=http://<dashboard-host>:<port>
# optional: where the power scaler keeps its state (mounted read-only at /host/scaler)
# SJC_SCALER_DIR=/path/to/scaler
# SJC_SCALER_STATE=/host/scaler/state.json

# --- any other server: agent only, publishing to the main server's broker ---
# COMPOSE_PROFILES=agent
# SJC_HOST=server-b
# SJC_MQTT_HOST=<main-server-address>
# with an NVIDIA GPU (needs nvidia-container-toolkit):
# COMPOSE_FILE=compose.yaml:compose.gpu.yaml
# controller files kept in /dev/shm instead of /run:
# SJC_FAN_CONTROL_STATE=/host/shm/fan-control.json
# SJC_RUN_PROFILE_FILE=/host/shm/run-profile.json
# SJC_LIMITS_FILE=/host/shm/component-limits.json

# --- UI / group standard (DEV-STANDARD section 5) ---
# wrapper origins allowed to frame the UI, space-separated (list the Home dashboards origins in the real .env)
FRAME_ANCESTORS="http://<wrapper-host>:<wrapper-port>"
UI_BASE_PATH=/
PUBLIC_URL=
LOGIN=off
OIDC_ISSUER=
OIDC_CLIENT_ID=
# machine names and descriptions for the UI: deploy/local/site.json (private, gitignored); see deploy/site.example.json
